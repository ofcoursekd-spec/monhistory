# --- Server ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,https://monhistory.vercel.app

# --- Supabase Postgres ---
# Récupérer depuis Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Utiliser le pooler (port 6543) en production, direct (5432) en dev.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?schema=public

# --- Supabase Storage ---
# Project Settings → API → URL + service_role key
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_BUCKET=pages
SUPABASE_SIGNED_URL_TTL_SECONDS=300

# --- JWT (auth maison MonHistory) ---
# JWT_ACCESS_SECRET est OBLIGATOIRE en prod (le bootstrap throw si vide).
JWT_ACCESS_SECRET=change_me_access
JWT_ACCESS_TTL=15m
# Le refresh token n'est PAS un JWT (random + SHA-256 en DB) → pas de secret nécessaire.
JWT_REFRESH_TTL=30d

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# --- FCM HTTP v1 (service account Google, pas firebase-admin) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- GeniusPay (https://geniuspay.ci) ---
# Sandbox : pk_sandbox_*, sk_sandbox_*  ;  Prod : pk_live_*, sk_live_*
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_PUBLIC_KEY=
GENIUSPAY_SECRET_KEY=
GENIUSPAY_WEBHOOK_SECRET=

# --- URL publique du site web (pour le error_url envoyé à GeniusPay) ---
PUBLIC_SITE_URL=http://localhost:3001

# --- Emails transactionnels (Resend — https://resend.com) ---
# Gratuit jusqu'à 100 emails/jour, 3000/mois. Sans clé, les emails sont loggés en console.
RESEND_API_KEY=
EMAIL_FROM=MonHistory <onboarding@resend.dev>
SUPPORT_EMAIL=contact@monhistory.app

# --- Règles d'accès ---
# Les prix des plans sont en DB (table Plan), pas en env.
# Aperçu gratuit : N premières pages du CHAPITRE 1 uniquement.
FREE_PREVIEW_PAGES=3
